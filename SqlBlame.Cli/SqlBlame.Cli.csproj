<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>SqlBlame</AssemblyName>
    <RootNamespace>SqlBlame.Cli</RootNamespace>
    <Version>0.0.1-dev</Version>
  </PropertyGroup>

  <PropertyGroup>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>sqlblame</ToolCommandName>
    <PackageId>SqlBlame</PackageId>
    <Authors>Uros Milic</Authors>
    <Copyright>© Uros Milic</Copyright>
    <Description>Interactive terminal tool for browsing the change history of SQL Server stored procedures from a DDL audit log, with colored diffs between versions.</Description>
    <PackageTags>sql-server;ddl;audit;diff;stored-procedures;tui;terminal;cli;dotnet-tool</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/umilic16/sqlblame</RepositoryUrl>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Spectre.Console" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SqlBlame.Core\SqlBlame.Core.csproj" />
  </ItemGroup>
</Project>
