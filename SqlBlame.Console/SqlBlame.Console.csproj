<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>SqlBlame</AssemblyName>
    <RootNamespace>SqlBlame.Console</RootNamespace>
    <Version>0.0.1-dev</Version>
  </PropertyGroup>

  <PropertyGroup>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>sqlblame</ToolCommandName>
    <PackageId>SqlBlame</PackageId>
    <Authors>Uros Milic</Authors>
    <Description>Interactive terminal tool for browsing the change history of SQL Server stored procedures from a DDL audit log, with colored diffs between versions.</Description>
    <PackageTags>sql-server;ddl;audit;diff;stored-procedures;cli;dotnet-tool</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/umilic16/sqlblame</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
    <PackageReference Include="Spectre.Console" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SqlBlame.Core\SqlBlame.Core.csproj" />
  </ItemGroup>
</Project>
